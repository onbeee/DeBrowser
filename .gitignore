*.db
*.db-shm
*.db-wal
data/
profiles/
logs/
backups/

# Local configuration and secrets
*.local.*
.env
.env.*
!.env.example
*subscription*.txt
*proxy*.local.*

# Browser user data and cookies (must never be committed)
**/User Data/
**/Cookies
**/Login Data

# IDE / OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Temporary files
tmp/
*.tmp
